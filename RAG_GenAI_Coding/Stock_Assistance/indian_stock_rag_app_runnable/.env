# API
API_HOST=0.0.0.0
API_PORT=8000

# Vector DB
QDRANT_HOST=qdrant
QDRANT_PORT=6333
COLLECTION_NAME=market_docs

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM (served by Ollama)
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Universe (tickers)
# For NSE in yfinance append .NS, e.g. RELIANCE.NS, TCS.NS, HDFCBANK.NS
TICKERS=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ICICIBANK.NS,LT.NS,SBIN.NS

# Ingestion schedule (cron: minute hour * * *) India time
CRON_DAILY=0 18 * * *
HISTORY_DAYS=365
